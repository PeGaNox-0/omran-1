<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Omran" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/green_dark</item>
        <item name="android:navigationBarColor">@color/green_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.Omran.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/green_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/green_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.Omran</item>
    </style>
</resources>
